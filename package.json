{
  "name": "tiny-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TinyOS - a playful, toddler-safe pretend operating system for iPad and touch screens",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:pages": "tsc --noEmit && vite build --outDir docs --emptyOutDir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
